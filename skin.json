{
  "name": "MediaWikiBootstrap",
  "namemsg": "skinname-mediawikibootstrap",
  "descriptionmsg": "mediawikibootstrap-desc",
  "version": "2.0.0",
  "url": "https://www.mediawiki.org/wiki/Skin:MediaWikiBootstrap",
  "author": [
    "[https://mediawiki.org/wiki/User:nasirkhan Nasir Khan Saikat]",
    "[https://github.com/nasirkhan/mediawiki-bootstrap/graphs/contributors Contributors]"
  ],
  "type": "skin",
  "requires": {
    "MediaWiki": ">= 1.43.0"
  },
  "ValidSkinNames": {
    "mediawikibootstrap": {
      "class": "MediaWiki\\Skins\\MediaWikiBootstrap\\SkinMediaWikiBootstrap",
      "args": [
        {
          "name": "mediawikibootstrap",
          "responsive": true,
          "bodyOnly": true,
          "menus": [
            "user-interface-preferences",
            "user-page",
            "user-menu",
            "notifications",
            "views",
            "actions",
            "variants",
            "associated-pages"
          ],
          "messages": [
            "mediawikibootstrap-no-categories",
            "mediawikibootstrap-categories",
            "login"
          ],
          "styles": ["skins.mediawikibootstrap"],
          "scripts": ["skins.mediawikibootstrap.js"]
        }
      ]
    }
  },
  "MessagesDirs": {
    "MediaWikiBootstrap": ["i18n"]
  },
  "ResourceModules": {
    "skins.mediawikibootstrap": {
      "class": "MediaWiki\\ResourceLoader\\SkinModule",
      "features": {
        "normalize": true,
        "elements": true,
        "content-media": true,
        "content-links": true,
        "content-tables": true,
        "interface-category": true,
        "interface-message-box": true,
        "toc": true
      },
      "styles": [
        "./resources/bootstrap/css/bootstrap.min.css",
        "./resources/skin.less"
      ]
    },
    "skins.mediawikibootstrap.js": {
      "scripts": [
        "./resources/bootstrap/js/bootstrap.bundle.js",
        "./resources/skin.js"
      ]
    }
  },
  "ResourceFileModulePaths": {
    "localBasePath": "",
    "remoteSkinPath": "MediaWikiBootstrap"
  },
  "AutoloadClasses": {
    "MediaWiki\\Skins\\MediaWikiBootstrap\\SkinMediaWikiBootstrap": "includes/MediaWikiBootstrap.skin.php"
  },
  "ResourceModuleSkinStyles": {},
  "config": {
    "MediaWikiBootstrapEnableSidebarMenu": {
      "value": false,
      "descriptionmsg": "mediawikibootstrap-config-enablesidebarmenu"
    }
  },
  "manifest_version": 2
}
