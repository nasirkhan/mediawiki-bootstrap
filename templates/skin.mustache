

<div id="main" class="container pb-4 px-4 shadow-sm">
	<header class="mw-header">
		<div class="container px-4">
			<div class="row justify-content-center">
				<div class="col-auto text-center py-2">
					{{>Logo}}
				</div>
			</div>
			<nav class="navbar navbar-expand-lg col-12 col-sm-10 mx-auto">
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
				<span class="navbar-toggler-icon"></span>
				</button>
				<div class="collapse navbar-collapse" id="navbarSupportedContent">
				<ul class="navbar-nav me-auto mb-2 mb-lg-0">
					{{#array-main-menu}}
					<li class="nav-item">
						<a class="nav-link" href="{{href}}">{{text}}</a>
					</li>
					{{/array-main-menu}}
					{{^array-main-menu}}
					<li class="nav-item">
						<a class="nav-link" href="{{link-mainpage}}">{{msg-mainpage}}</a>
					</li>
					{{/array-main-menu}}
					{{>SidebarDropdown}}
				</ul>
				{{{html-search-box}}}
				</div>
			</nav>
		</div>
	</header>
	<main id="content" class="mw-body">
		<div class="row justify-content-sm-center">
			<div class="col-12 col-sm-10">
				<div class="row">
					<div class="col content__header">
						{{>ContentIndicators}}
						{{>ContentHeading}}
						{{>ContentTagline}}
						{{>ContentNamespaces}}
						{{>ContentActions}}
					</div>
				</div>
				{{>ContentBody}}
			</div>
		</div>
	</main>

	<div>
		{{>Notifications}}
		{{>Dropdown}}{{>PersonalMenu}}
		{{#enable-sidebar-menu}}{{>Sidebar}}{{/enable-sidebar-menu}}
		{{>Notices}}
		{{>Languages}}
	</div>

</div>
<div id="footer" class="container my-4">
	{{>Footer}}
	{{{html-credit-line}}}
</div>