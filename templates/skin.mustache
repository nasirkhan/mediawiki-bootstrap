
<header class="mw-header">
	<nav class="navbar navbar-expand-lg w-100 d-flex flex-column px-4">
		<div class="d-flex align-items-center w-100">
			<div class="mw-header-logo flex-shrink-1 flex-grow-1 overflow-hidden me-2">{{>Logo}}</div>
			<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
				<span class="navbar-toggler-icon"></span>
			</button>
		</div>
		<div class="collapse navbar-collapse" id="navbarSupportedContent">
			<ul class="navbar-nav me-auto mb-2 mb-lg-0">
				{{#array-main-menu}}
				<li class="nav-item">
					<a class="nav-link" href="{{href}}">{{text}}</a>
				</li>
				{{/array-main-menu}}
				{{^array-main-menu}}
				<li class="nav-item">
					<a class="nav-link" href="{{link-mainpage}}">{{msg-mainpage}}</a>
				</li>
				{{/array-main-menu}}
				{{^is-anon}}{{>SidebarDropdown}}{{/is-anon}}
				{{^is-anon}}{{>PageActionsDropdown}}{{/is-anon}}
			</ul>
			<ul class="navbar-nav ms-2 mb-2 mb-lg-0">
				{{>NavbarNotifications}}
				{{>NavbarUserMenu}}
			</ul>
			{{{html-search-box}}}
		</div>
	</nav>
</header>
<div id="main" class="container pb-4 px-4 shadow-sm">
	<main id="content" class="mw-body">
		<div class="row justify-content-sm-center">
			<div class="col-12 col-sm-10">
				<div class="row">
					<div class="col content__header">
						{{>ContentIndicators}}
						{{>ContentHeading}}
						{{>ContentTagline}}
						{{>ContentNamespaces}}
						{{>ContentActions}}
					</div>
				</div>
				{{>ContentBody}}
			</div>
		</div>
	</main>

	<div>
		{{#enable-sidebar-menu}}{{>Sidebar}}{{/enable-sidebar-menu}}
		{{>Notices}}
		{{>Languages}}
	</div>

</div>
<div id="footer" class="container my-4">
	{{>Footer}}
	{{{html-credit-line}}}
	{{#html-custom-footer}}
	<div class="text-center mt-2" style="font-size: 0.85em; color: #666;">
		{{{html-custom-footer}}}
	</div>
	{{/html-custom-footer}}
</div>
